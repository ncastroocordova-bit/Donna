# === Telegram ===
TELEGRAM_TOKEN=
NICO_TELEGRAM_ID=

# === Claude (Anthropic) ===
ANTHROPIC_API_KEY=
# Opcional (tienen default): MODEL_BRAIN=claude-sonnet-4-6  MODEL_CHEAP=claude-haiku-4-5

# === Supabase (proyecto "Donna") ===
SUPABASE_URL=https://bmwbtrfgtttgbsanxnxi.supabase.co
# IMPORTANTE: usar la SERVICE_ROLE key (Dashboard → Settings → API → service_role, "secret").
# NO la anon/publishable. Con RLS activado, solo la service_role accede. Es secreta.
SUPABASE_KEY=

# === Voyage AI (embeddings) ===
VOYAGE_API_KEY=

# === Whisper (voz) ===
OPENAI_API_KEY=

# === Correo (gastos por mail + spam) ===
# Genera los tokens UNA vez con: python auth_email.py  (sigue las instrucciones en consola)
# Gmail API (scope gmail.modify): crea credenciales OAuth "App de escritorio" en Google Cloud.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Outlook personal vía Microsoft Graph: registra una app en Azure (cuentas "personales"),
# tipo cliente público, permiso delegado Mail.ReadWrite + offline_access.
OUTLOOK_CLIENT_ID=
OUTLOOK_REFRESH_TOKEN=
# Opcionales (tienen default): CORREO_DIAS=2  SPAM_HORA=9  SPAM_MAX=25

# === Google (Sheets + Calendar) ===
GOOGLE_CREDENTIALS_JSON=credentials.json
# Canon v7.2: UN solo workbook "Donna" (vida + finanzas juntos). Compártelo con
# el email del service account y pega su id acá.
GOOGLE_SHEET_ID=
# Legacy (etapa de dos planillas): solo se usan si GOOGLE_SHEET_ID está vacío.
GOOGLE_SHEET_ID_VIDA=
GOOGLE_SHEET_ID_FINANZAS=
# Calendario compartido con el email del service account (o 'primary' si aplica)
GOOGLE_CALENDAR_ID=primary

# === Operación (opcional) ===
TIMEZONE=America/Santiago
META_HORA_DORMIR=23:00
